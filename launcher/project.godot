; GodotLiveMCP Launcher — open this folder in Godot (or run
; `godot --path launcher`) to set up the server and link projects.

config_version=5

[application]

config/name="GodotLiveMCP Launcher"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=760
window/size/viewport_height=560
display_server/driver.linuxbsd="wayland"

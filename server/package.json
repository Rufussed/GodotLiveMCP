{
  "name": "godot-live-mcp",
  "version": "0.1.0",
  "description": "MCP server for driving a running Godot 4 editor session live: structured scene/node tools plus a live GDScript eval REPL, on top of godot-mcp's project lifecycle tools.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "live-eval"
  ],
  "homepage": "https://github.com/Rufussed/GodotLiveMCP",
  "bugs": {
    "url": "https://github.com/Rufussed/GodotLiveMCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rufussed/GodotLiveMCP.git"
  },
  "license": "MIT",
  "author": "GodotLiveMCP contributors (forked from godot-mcp by Solomon Elias)",
  "type": "module",
  "bin": {
    "godot-live-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "link-project": "node scripts/link-project.js",
    "inspector":"npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.7.9",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
